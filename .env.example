# =====================================================================
# Plantilla de variables de entorno. Copia este archivo a `.env` (local)
# o cargalas en Vercel. NUNCA pongas valores reales aqui: este archivo
# se versiona y el repositorio es publico.
# =====================================================================

# --- Base de datos y sesion -------------------------------------------
# OBLIGATORIA. Cadena de conexion a Postgres (Neon).
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# OBLIGATORIA. Firma las cookies de sesion. Cadena larga y aleatoria.
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Entorno de ejecucion. En Vercel debe ser "production".
NODE_ENV=production
# OPCIONAL. 1 apaga correo, push y tareas programadas (util en pruebas).
DISABLE_SIDE_EFFECTS=

# --- Autenticacion (Supabase) - SERVIDOR ------------------------------
# OBLIGATORIA. URL del proyecto Supabase.
SUPABASE_URL=https://tu-proyecto.supabase.co
# OBLIGATORIA. Clave publicable (anon) de Supabase.
SUPABASE_PUBLISHABLE_KEY=relleno-clave-publicable
# OBLIGATORIA. Clave de servicio. SECRETA: nunca lleva prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=relleno-clave-de-servicio-secreta

# --- Autenticacion (Supabase) - CLIENTE (se fijan en el BUILD) --------
# Las variables VITE_* deben existir ANTES de compilar; quedan visibles
# en el navegador, asi que jamas pongas secretos aqui.
# OBLIGATORIA.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# OBLIGATORIA.
VITE_SUPABASE_PUBLISHABLE_KEY=relleno-clave-publicable
# RECOMENDADA. URL publica del sitio, SIN barra final.
VITE_SITE_URL=https://appdepichangas.vercel.app
# OPCIONAL. 1 desactiva WebSocket (en Vercel no hay WebSocket).
VITE_DISABLE_WS=1
# OPCIONAL, solo app nativa (Capacitor): esquema de retorno de login.
VITE_NATIVE_AUTH_SCHEME=
# OPCIONAL, solo app nativa: usar el origen web en lugar del esquema.
VITE_NATIVE_USE_WEB_ORIGIN=

# --- Correo -----------------------------------------------------------
# OPCIONAL. Clave de Resend para enviar correos.
RESEND_API_KEY=

# --- Almacenamiento de objetos (Cloudflare R2) ------------------------
# Necesario para subir fotos, adjuntos, comprobantes y portadas en
# Vercel (alli el disco es de solo lectura).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ID-DE-CUENTA.r2.cloudflarestorage.com
R2_BUCKET_NAME=
# Ruta privada dentro del bucket, p. ej. /nombre-bucket/privado
PRIVATE_OBJECT_DIR=
# Rutas publicas separadas por coma, p. ej. /nombre-bucket/publico
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Notificaciones push ----------------------------------------------
# OPCIONALES. Sin ellas no se envian notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# JSON de la cuenta de servicio de Firebase (en una sola linea).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Vercel -----------------------------------------------------------
# OBLIGATORIA en Vercel. Protege /api/cron/jobs (Authorization: Bearer).
# Cadena larga y aleatoria.
CRON_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria
# 1 solo la primera vez o cuando haya columnas nuevas; luego quitar.
RUN_MIGRATIONS=
